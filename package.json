{
  "name": "scale-evo-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "users:provision": "tsx --env-file-if-exists=.env scripts/provision-users.ts",
    "postinstall": "prisma generate",
    "leads:geocode": "tsx --env-file-if-exists=.env scripts/backfill-lead-coordinates.ts",
    "instagram:check": "tsx --env-file-if-exists=.env scripts/check-instagram-graph.ts",
    "instagram:setup": "tsx --env-file-if-exists=.env scripts/setup-instagram-graph.ts"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@prisma/client": "^6.7.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@types/leaflet": "^1.9.22",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "groq-sdk": "^1.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.3.2",
    "prisma": "^6.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  }
}
