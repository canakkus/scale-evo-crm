# ============================================================
# Scale Evo CRM 3.0 — Umgebungsvariablen
# Kopiere diese Datei nach .env und fülle die Werte aus.
# ============================================================

# ---- Supabase (Pflichtfelder) ----
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ---- Datenbank (Prisma) ----
# Pooler-URL für normale Queries
DATABASE_URL=""
# Direkte URL für Migrationen
DIRECT_URL=""

# ---- Auth & Session Secret ----
SESSION_SECRET=""
AUTH_SALT=""
LUCARIO_AUTH_PASSWORD=""
ADMIN_EMAIL=""

# ---- Auth: erlaubte E-Mails (komma-getrennt) ----
LOCALCRM_ALLOWED_USER_EMAILS=""

# ---- Supabase Service-Role (NUR lokal, NICHT in Vercel!) ----
# Wird nur für users:provision benötigt
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Benutzer-Provisioning (NUR lokal!) ----
LOCALCRM_USER_1_EMAIL=""
LOCALCRM_USER_1_NAME=""
LOCALCRM_USER_1_PASSWORD=""
LOCALCRM_USER_2_EMAIL=""
LOCALCRM_USER_2_NAME=""
LOCALCRM_USER_2_PASSWORD=""

# ---- Gemini KI (Pflichtfeld für KI-Features) ----
GEMINI_API_KEY=""

# ---- Instagram Graph API (Business Discovery) ----
# Offizieller Weg an fremde Profildaten: Bio, Link-in-Bio, Follower,
# letzter Post. Ohne diese Werte fällt das CRM auf den öffentlichen
# Seitenabruf zurück, der nur die Followerzahl liefert.
#
# Einrichtung:
#   1. Eigenen Instagram-Account auf Business oder Creator umstellen
#      und mit einer Facebook-Seite verknüpfen
#   2. Auf developers.facebook.com eine App anlegen, Instagram-Produkt
#      hinzufügen und die Instagram-Berechtigungen erteilen
#   3. Langlebiges Access-Token erzeugen (kurzlebige laufen nach ~1 Std ab)
#   4. Eigene Instagram-Business-Account-ID ermitteln
#      (NICHT die Facebook-Seiten-ID und nicht die App-ID)
#   5. Prüfen mit:  npm run instagram:check
# Für die Einrichtung via npm run instagram:setup
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

INSTAGRAM_GRAPH_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""
# Optional, sonst v21.0
INSTAGRAM_GRAPH_VERSION=""

# ---- Apify (Instagram-Profildaten, kostenpflichtiger Rückfall) ----
# Zweite Quelle in der Kette: Graph API -> Apify -> öffentlicher Abruf.
# Wird gebraucht, solange Meta keinen Advanced Access für instagram_basic
# gewährt hat und `business_discovery` mit
#   (#10) Application does not have permission for this action
# scheitert.
#
# KOSTEN: ca. $1,60 pro 1.000 Profile. Jeder Abruf kostet echtes Geld.
# Deshalb greifen automatisch ein Vorfilter und ein 30-Tage-Snapshot-Cache;
# die Generierung von Nachrichten löst NIE einen Abruf aus.
#
# Einrichtung:
#   1. Konto auf apify.com anlegen
#   2. Token unter Settings -> Integrations kopieren
#   3. Prüfen mit:  npm run instagram:check
#      Echter (kostenpflichtiger) Testlauf:
#      npm run instagram:check -- <handle> --apify
#
# Ohne Token ist die Quelle schlicht inaktiv — das CRM fällt dann auf den
# öffentlichen Seitenabruf zurück.
APIFY_TOKEN=""
# Optional, sonst apify~instagram-profile-scraper
APIFY_INSTAGRAM_ACTOR=""
# Optional, sonst 90000 ms (serverseitiges Limit liegt bei 300 s)
APIFY_TIMEOUT_MS=""
# Optional, sonst 150. Obergrenze bezahlter Profilabrufe pro rollender Stunde,
# über alle Läufe hinweg. Handbremse gegen Versehen, kein Sicherheitsfeature.
APIFY_HOURLY_LIMIT=""

# ---- Google Places API (optional, für Autofill) ----
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACES_REGION="AT"

# ---- Groq (optional, Legacy-Fallback) ----
# GROQ_API_KEYS=""

# ---- Apple iCloud CalDAV Bridge (exklusiv für canakkus378@gmail.com) ----
# App-spezifisches Passwort auf appleid.apple.com erstellen
ICLOUD_USER="canakkus378@gmail.com"
ICLOUD_APP_PASSWORD=""
ICLOUD_REMINDERS_LIST="WORKSHIT"
ICLOUD_CALENDAR_NAME="Privat"


# Accounts, die gegenseitig alle Leads sehen. Mitglieder mit ",", Gruppen mit ";" trennen.
# Beispiel: SHARED_WORKSPACE_EMAILS="a@x.at,b@y.com;c@z.at,d@z.at"
SHARED_WORKSPACE_EMAILS=""
